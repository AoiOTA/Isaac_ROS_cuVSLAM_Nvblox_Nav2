# Sourced by scripts/lib/common.sh. PROJECT_ROOT is set before this file is read.
export ROS_DISTRO="jazzy"
export ROS_SETUP="/opt/ros/jazzy/setup.bash"

export ISAAC_SIM_ENV="/home/lyb/miniconda3/envs/isaacsim"
export ISAAC_SIM_PYTHON="${ISAAC_SIM_ENV}/bin/python"
export ISAAC_ASSET_ROOT="/home/lyb/isaacsim_assets/Assets/Isaac/6.0"

export WAREHOUSE_USD="${ISAAC_ASSET_ROOT}/Isaac/Environments/Simple_Warehouse/warehouse_with_forklifts.usd"
export NOVA_CARTER_USD="${ISAAC_ASSET_ROOT}/Isaac/Robots/NVIDIA/NovaCarter/nova_carter.usd"
export NOVA_CARTER_ROS_SAMPLE_USD="${ISAAC_ASSET_ROOT}/Isaac/Samples/ROS2/Robots/Nova_Carter_ROS.usd"

export RMW_IMPLEMENTATION="rmw_fastrtps_cpp"
export ROS_DOMAIN_ID="42"
export ROS_LOCALHOST_ONLY="1"
export FASTRTPS_DEFAULT_PROFILES_FILE="${PROJECT_ROOT}/config/fastdds.xml"
export PYTHONUNBUFFERED="1"

# Project-local Isaac ROS 4.5 toolchain environment. Public scripts source this
# file, so no ~/.bashrc edits are needed.
export ISAAC_ROS_RELEASE="4.5"
export CUDA_HOME="/usr/local/cuda"
export PATH="/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/src/tensorrt/bin:${PATH}"
