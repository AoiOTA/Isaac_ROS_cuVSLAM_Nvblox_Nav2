Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 34; 34; 34
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Nova Carter
      Enabled: true
      Description Source: Topic
      Description File: ""
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      Links:
        All Links Enabled: true
        Expand Tree: false
        Expand Link Details: false
        Expand Joint Details: false
        Link Tree Style: Links in Alphabetic Order
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
      Tree: {}
    - Class: rviz_common/Group
      Name: Maps and costmaps
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Occupancy map
          Enabled: true
          Alpha: 0.75
          Color Scheme: map
          Draw Behind: true
          Topic:
            Value: /map
            Reliability Policy: Reliable
            Durability Policy: Transient Local
            History Policy: Keep Last
            Depth: 1
          Update Topic:
            Value: /map_updates
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Map
          Name: Global costmap
          Enabled: true
          Alpha: 0.45
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /global_costmap/costmap
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Update Topic:
            Value: /global_costmap/costmap_updates
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Map
          Name: Local costmap
          Enabled: true
          Alpha: 0.70
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /local_costmap/costmap
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Update Topic:
            Value: /local_costmap/costmap_updates
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
    - Class: rviz_common/Group
      Name: Localization and paths
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: cuVSLAM VO trajectory
          Enabled: true
          Line Style: Lines
          Line Width: 0.03
          Color: 0; 255; 255
          Topic:
            Value: /visual_slam/tracking/vo_path
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: cuVSLAM SLAM trajectory
          Enabled: true
          Line Style: Lines
          Line Width: 0.04
          Color: 255; 120; 0
          Topic:
            Value: /visual_slam/tracking/slam_path
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: Global path
          Enabled: true
          Line Style: Billboards
          Line Width: 0.06
          Color: 0; 255; 0
          Topic:
            Value: /plan
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: Local MPPI path
          Enabled: true
          Line Style: Billboards
          Line Width: 0.04
          Color: 255; 0; 255
          Topic:
            Value: /transformed_global_plan
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
    - Class: rviz_common/Group
      Name: Nvblox
      Enabled: true
      Displays:
        - Class: nvblox_rviz_plugin/NvbloxMesh
          Name: TSDF mesh
          Enabled: true
          Mesh Color: Color
          Cut Ceiling: true
          Ceiling Height: 1.8
          Topic:
            Value: /nvblox_node/mesh
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Static ESDF
          Enabled: true
          Style: Flat Squares
          Size (Pixels): 3
          Size (m): 0.03
          Color Transformer: Intensity
          Position Transformer: XYZ
          Topic:
            Value: /nvblox_node/static_esdf_pointcloud
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Dynamic ESDF
          Enabled: true
          Style: Flat Squares
          Size (Pixels): 4
          Size (m): 0.04
          Color Transformer: FlatColor
          Color: 255; 60; 40
          Position Transformer: XYZ
          Topic:
            Value: /nvblox_node/dynamic_esdf_pointcloud
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Combined ESDF
          Enabled: false
          Style: Flat Squares
          Size (Pixels): 3
          Size (m): 0.03
          Color Transformer: Intensity
          Position Transformer: XYZ
          Topic:
            Value: /nvblox_node/combined_esdf_pointcloud
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Dynamic depth points
          Enabled: true
          Style: Spheres
          Size (Pixels): 5
          Size (m): 0.06
          Color Transformer: FlatColor
          Color: 255; 0; 0
          Position Transformer: XYZ
          Topic:
            Value: /nvblox_node/dynamic_points
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
    - Class: rviz_common/Group
      Name: Visual sensors and safety
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Image
          Name: Front left image
          Enabled: true
          Normalize Range: true
          Topic:
            Value: /front_stereo_camera/left/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Image
          Name: Front depth
          Enabled: true
          Normalize Range: true
          Min Value: 0
          Max Value: 6
          Topic:
            Value: /front_stereo_camera/depth/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Image
          Name: Left Hawk on demand
          Enabled: false
          Normalize Range: true
          Topic:
            Value: /left_stereo_camera/left/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Image
          Name: Right Hawk on demand
          Enabled: false
          Normalize Range: true
          Topic:
            Value: /right_stereo_camera/left/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Image
          Name: Back Hawk on demand
          Enabled: false
          Normalize Range: true
          Topic:
            Value: /back_stereo_camera/left/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/LaserScan
          Name: Depth safety scan
          Enabled: true
          Style: Points
          Size (Pixels): 4
          Color Transformer: FlatColor
          Color: 255; 40; 40
          Topic:
            Value: /front_depth/scan
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Depth obstacles in odom
          Enabled: true
          Style: Flat Squares
          Size (Pixels): 4
          Size (m): 0.03
          Color Transformer: FlatColor
          Color: 255; 80; 40
          Position Transformer: XYZ
          Topic:
            Value: /front_depth/points_odom
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Polygon
          Name: Collision stop zone
          Enabled: true
          Color: 255; 0; 0
          Alpha: 0.35
          Topic:
            Value: /collision_monitor/stop_zone
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Polygon
          Name: Collision slowdown zone
          Enabled: true
          Color: 255; 200; 0
          Alpha: 0.25
          Topic:
            Value: /collision_monitor/slowdown_zone
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 0.75
      Yaw: 0.75
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1600
  Height: 1000
