<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nova_carter">
  <!-- Values were extracted from the composed Isaac Sim 6.0 Nova Carter USD. -->
  <material name="nova_dark"><color rgba="0.12 0.15 0.18 1"/></material>
  <material name="nova_green"><color rgba="0.20 0.75 0.35 1"/></material>
  <material name="wheel_black"><color rgba="0.025 0.025 0.025 1"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="-0.2335 0 0.34" rpy="0 0 0"/>
      <geometry><box size="0.747 0.50 0.40"/></geometry>
      <material name="nova_dark"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 0.58" rpy="0 0 0"/>
      <geometry><box size="0.20 0.32 0.10"/></geometry>
      <material name="nova_green"/>
    </visual>
  </link>
  <link name="front_stereo_camera_link"/>
  <link name="front_stereo_camera_left_optical"/>
  <link name="front_stereo_camera_right_optical"/>
  <link name="front_stereo_camera_imu"/>

  <joint name="front_stereo_mount" type="fixed">
    <parent link="base_link"/><child link="front_stereo_camera_link"/>
    <origin xyz="0.1003 -0.000002 0.3459" rpy="0 0 0"/>
  </joint>
  <joint name="front_stereo_left_optical_joint" type="fixed">
    <parent link="front_stereo_camera_link"/><child link="front_stereo_camera_left_optical"/>
    <origin xyz="0 0.075 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <joint name="front_stereo_right_optical_joint" type="fixed">
    <parent link="front_stereo_camera_link"/><child link="front_stereo_camera_right_optical"/>
    <origin xyz="0 -0.075 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <joint name="front_stereo_imu_joint" type="fixed">
    <parent link="front_stereo_camera_link"/><child link="front_stereo_camera_imu"/>
    <origin xyz="0 -0.0197 0.0061" rpy="0 1.57079632679 0"/>
  </joint>

  <link name="wheel_left">
    <visual><geometry><cylinder radius="0.14" length="0.06"/></geometry><material name="wheel_black"/></visual>
  </link>
  <link name="wheel_right">
    <visual><geometry><cylinder radius="0.14" length="0.06"/></geometry><material name="wheel_black"/></visual>
  </link>
  <joint name="joint_wheel_left" type="continuous">
    <parent link="base_link"/><child link="wheel_left"/>
    <origin xyz="0 0.2066 0.14" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_wheel_right" type="continuous">
    <parent link="base_link"/><child link="wheel_right"/>
    <origin xyz="0 -0.2066 0.14" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="caster_frame_base"/><link name="caster_swing_left"/>
  <link name="caster_swing_right"/><link name="caster_wheel_left"/>
  <link name="caster_wheel_right"/>
  <joint name="joint_caster_base" type="continuous">
    <parent link="base_link"/><child link="caster_frame_base"/>
    <origin xyz="-0.47195 0 0.22289" rpy="-1.57079632679 0 1.57079632679"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_swing_left" type="continuous">
    <parent link="caster_frame_base"/><child link="caster_swing_left"/>
    <origin xyz="0.132296 0.031188 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_swing_right" type="continuous">
    <parent link="caster_frame_base"/><child link="caster_swing_right"/>
    <origin xyz="-0.132296 0.031188 0" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_caster_left" type="continuous">
    <parent link="caster_swing_left"/><child link="caster_wheel_left"/>
    <origin xyz="-0.04 0.115393 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint_caster_right" type="continuous">
    <parent link="caster_swing_right"/><child link="caster_wheel_right"/>
    <origin xyz="-0.04 0.115393 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
</robot>
