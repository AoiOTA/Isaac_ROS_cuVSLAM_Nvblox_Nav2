Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 34; 34; 34
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 110; 110; 110
      Alpha: 0.45
    - Class: rviz_default_plugins/RobotModel
      Name: Jackal
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      Links:
        All Links Enabled: true
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: true
      Tree: {}
    - Class: rviz_common/Group
      Name: Mapping progress
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: cuVSLAM map trajectory
          Enabled: true
          Line Style: Billboards
          Line Width: 0.055
          Color: 255; 145; 0
          Topic:
            Value: /visual_slam/tracking/slam_path
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: cuVSLAM odometry trajectory
          Enabled: false
          Line Style: Lines
          Line Width: 0.03
          Color: 0; 220; 255
          Topic:
            Value: /visual_slam/tracking/vo_path
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: nvblox_rviz_plugin/NvbloxMesh
          Name: Live nvblox mesh
          Enabled: true
          Mesh Color: Color
          Cut Ceiling: true
          Ceiling Height: 1.8
          Topic:
            Value: /nvblox_node/mesh
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/PointCloud2
          Name: Static ESDF
          Enabled: true
          Style: Flat Squares
          Size (Pixels): 3
          Size (m): 0.03
          Color Transformer: Intensity
          Position Transformer: XYZ
          Topic:
            Value: /nvblox_node/static_esdf_pointcloud
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
    - Class: rviz_common/Group
      Name: Sensor views (disabled by default)
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Image
          Name: Front left image
          Enabled: false
          Normalize Range: true
          Topic:
            Value: /front_stereo_camera/left/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 2
        - Class: rviz_default_plugins/Image
          Name: Front depth
          Enabled: false
          Normalize Range: true
          Min Value: 0.4
          Max Value: 6
          Topic:
            Value: /front_stereo_camera/depth/image_raw
            Reliability Policy: Best Effort
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 2
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Mapping overview
      Distance: 14
      Pitch: 1.35
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Width: 1600
  Height: 1000
