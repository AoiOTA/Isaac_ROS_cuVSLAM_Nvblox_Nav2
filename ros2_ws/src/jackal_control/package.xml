<?xml version="1.0"?>
<package format="3">
  <name>jackal_control</name>
  <version>0.1.0</version>
  <description>Safe differential-drive command and wheel odometry for Jackal.</description>
  <maintainer email="lyb@example.com">lyb</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nvblox_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
